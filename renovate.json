{
	"$schema": "https://docs.renovatebot.com/renovate-schema.json",
	"extends": [
		"local>buehler/renovate-config",
		"config:best-practices"
	],
	"ignoreTests": true,
	"packageRules": [
		{
			"description": "Group Jekyll and its plugins",
			"matchManagers": ["bundler"],
			"groupName": "Jekyll"
		},
		{
			"description": "Automerge minor and patch updates if CI passes",
			"matchUpdateTypes": ["minor", "patch"],
			"automerge": true,
			"automergeType": "pr",
			"platformAutomerge": true
		}
	]
}
