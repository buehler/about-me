{
	"$schema": "https://docs.renovatebot.com/renovate-schema.json",
	"extends": [
		"local>buehler/renovate-config",
		"config:best-practices",
		"config:js-app"
	],
	"ignoreTests": true,
	"packageRules": [
		{
			"matchPackageNames": ["typescript"],
			"allowedVersions": "<6.0.0"
		},
		{
			"description": "Group Next.js core framework updates together",
			"matchPackageNames": ["next"],
			"matchPackagePrefixes": ["@next/"],
			"groupName": "Next.js core"
		},
		{
			"description": "Group React core dependencies with Next.js to prevent peer mismatch",
			"matchPackageNames": ["react", "react-dom"],
			"matchPackagePrefixes": ["@types/react"],
			"groupName": "React core"
		},
		{
			"description": "Automerge minor and patch updates if CI passes",
			"matchUpdateTypes": ["minor", "patch"],
			"automerge": true,
			"automergeType": "pr",
			"platformAutomerge": true
		}
	]
}
